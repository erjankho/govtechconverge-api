# Environment variables for local development.
# Copy this file before running any command:  cp .env.example .env
#
# Each variable below notes the commands that read it. A variable marked
# "required by" causes that command to exit on startup when it is missing.

# --- Database ---------------------------------------------------------------
# required by: server, db:migrate, db:rollback, db:drop
# required by: sync:onedrive
# The database name must match POSTGRES_DB in docker-compose.yml.
POSTGRES_DSN=postgres://root:secret@localhost:5432/openconverge-dev

# --- OpenAI -----------------------------------------------------------------
# required by: server, sync:onedrive
# Any OpenAI-compatible endpoint works, including gateways such as Amazon
# Bedrock (e.g. https://bedrock-mantle.<region>.api.aws/v1).
OPENAI_API_KEY=
OPENAI_API_BASE_URL=

# required by: server
# Passed through to the API verbatim, so gateway-namespaced names are accepted
# (e.g. openai.gpt-oss-120b on Bedrock). Not read by sync:onedrive.
OPENAI_CHAT_MODEL=gpt-4o

# required by: server, sync:onedrive
# Must emit 1536-dimension vectors to match the vector(1536) columns on the
# embeddings and email_embeddings tables. Changing this needs a migration.
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002

# --- Microsoft Graph --------------------------------------------------------
# required by: sync:onedrive
# optional for: server - the client is built lazily and is only used by the
# 'retrieveEmails' tool. The server starts fine when these are blank, but
# POST /messages fails if the model decides to call that tool.
MSGRAPH_API_TENANT_ID=
MSGRAPH_API_CLIENT_ID=
MSGRAPH_API_CLIENT_SECRET=

# --- Azure Document Intelligence --------------------------------------------
# required by: sync:onedrive
# Not read by the server, so these can stay blank for API-only work.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_API_KEY=

# --- Optional overrides -----------------------------------------------------
# Defaults shown; uncomment only to change them.
# NODE_ENV=development
# PORT=8001
# SERVER_SHUTDOWN_GRACE_PERIOD=10000
